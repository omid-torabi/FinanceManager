<Window x:Class="FinanceManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" 
        Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Closing="Window_Closing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="🔐" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" 
                   Text="Enter your password:" 
                   FontSize="14" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <PasswordBox x:Name="PasswordBox" 
                     Grid.Row="2" 
                     Height="35" 
                     FontSize="16" 
                     Margin="0,0,0,10" 
                     KeyDown="PasswordBox_KeyDown"/>

        <TextBlock x:Name="ErrorText" 
                   Grid.Row="3" 
                   Text="" 
                   Foreground="Red" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,10"/>

        <Button Grid.Row="4" 
                Content="Login" 
                Height="40" 
                FontSize="16" 
                Click="LoginButton_Click" 
                Background="#3498DB" 
                Foreground="White" 
                FontWeight="Bold"/>

        <TextBlock Grid.Row="5" 
                   Text="If needed, delete the password from the AppData folder." 
                   FontSize="10" 
                   Foreground="Gray" 
                   HorizontalAlignment="Center" 
                   Margin="0,10,0,0"/>
    </Grid>
</Window>