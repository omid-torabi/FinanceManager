<Window x:Class="FinanceManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👤 About Me" Height="550" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📋 About This App" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Personal Finance Manager - Version 1.0.0" FontSize="12" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,10">

                <Border Background="#ECF0F1" Padding="12" CornerRadius="5" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="👤 Name" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="NameText" Text="[Name]" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECF0F1" Padding="12" CornerRadius="5" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="📧 Email" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="EmailText" Text="[Email]" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECF0F1" Padding="12" CornerRadius="5" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="🛠️ Skills" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="SkillText" Text="[Skills]" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#ECF0F1" Padding="12" CornerRadius="5" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="📝 About Me" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="AboutText" Text="[About Me]" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Button Content="🔒 Close" Height="35" FontSize="14" Click="CloseButton_Click" Background="#3498DB" Foreground="White" FontWeight="Bold" Width="120" HorizontalAlignment="Center" Margin="0,10,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>