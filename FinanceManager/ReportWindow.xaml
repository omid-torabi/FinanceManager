<Window x:Class="FinanceManager.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monthly Report" Height="450" Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Center">
            <TextBlock Text="Month:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="MonthComboBox" Width="120" SelectionChanged="MonthComboBox_SelectionChanged"/>
            <TextBlock Text="Year:" VerticalAlignment="Center" Margin="20,0,10,0"/>
            <ComboBox x:Name="YearComboBox" Width="100" SelectionChanged="YearComboBox_SelectionChanged"/>
            <Button Content="Refresh" Width="100" Height="30" Margin="20,0,0,0" Click="RefreshReportButton_Click" Background="#3498DB" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#2C3E50" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Income" Foreground="#2ECC71" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="IncomeText" Text="0 Euro" Foreground="#2ECC71" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Expense" Foreground="#E74C3C" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ExpenseText" Text="0 Euro" Foreground="#E74C3C" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Balance" Foreground="#F1C40F" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BalanceText" Text="0 Euro" Foreground="#F1C40F" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" x:Name="CategoryGrid" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Key}" Width="*"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Value, StringFormat=N0}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>