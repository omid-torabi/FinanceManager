<Window x:Class="FinanceManager.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Transaction" Height="400" Width="450"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="➕ New Transaction" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Title:" Width="100" FontSize="14" VerticalAlignment="Center"/>
            <TextBox x:Name="TitleTextBox" Width="250" FontSize="14" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Amount (€):" Width="100" FontSize="14" VerticalAlignment="Center"/>
            <TextBox x:Name="AmountTextBox" Width="250" FontSize="14" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Date:" Width="100" FontSize="14" VerticalAlignment="Center"/>
            <DatePicker x:Name="DatePicker" Width="250" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Category:" Width="100" FontSize="14" VerticalAlignment="Center"/>
            <ComboBox x:Name="CategoryComboBox" Width="250" FontSize="14" Padding="5" IsEditable="True"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Type:" Width="100" FontSize="14" VerticalAlignment="Center"/>
            <ComboBox x:Name="TypeComboBox" Width="250" FontSize="14" Padding="5">
                <ComboBoxItem Content="💰 Income" Tag="Income"/>
                <ComboBoxItem Content="💸 Expense" Tag="Expense"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="SaveButton" Content="✅ Save" Width="120" Height="40" Margin="5" Click="SaveButton_Click" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="CancelButton" Content="❌ Cancel" Width="120" Height="40" Margin="5" Click="CancelButton_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>