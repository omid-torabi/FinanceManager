<Window x:Class="FinanceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Finance Manager" Height="550" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="💰 Finance Manager" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Grid.Column="2" x:Name="BalanceText" Text="Balance: 0 €" FontSize="18" FontWeight="Bold" Foreground="#2ECC71"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Center">
            <Button x:Name="AddButton" Content="➕ Add" Width="100" Height="35" Margin="5" Click="AddButton_Click" Background="#3498DB" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="EditButton" Content="✏️ Edit" Width="100" Height="35" Margin="5" Click="EditButton_Click" Background="#F39C12" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="DeleteButton" Content="🗑️ Delete" Width="100" Height="35" Margin="5" Click="DeleteButton_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="ReportButton" Content="📊 Report" Width="100" Height="35" Margin="5" Click="ReportButton_Click" Background="#8E44AD" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="ExportButton" Content="💾 Backup" Width="100" Height="35" Margin="5" Click="ExportButton_Click" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="ImportButton" Content="📂 Restore" Width="100" Height="35" Margin="5" Click="ImportButton_Click" Background="#F39C12" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="AboutButton" Content="👤 About" Width="100" Height="35" Margin="5" Click="AboutButton_Click" Background="#34495E" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#ECF0F1" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox" Grid.Column="0" FontSize="14" Padding="5" TextChanged="SearchTextBox_TextChanged"/>

                <ComboBox x:Name="TypeFilterComboBox" Grid.Column="1" Width="100" FontSize="14" Margin="10,0,0,0" SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Income"/>
                    <ComboBoxItem Content="Expense"/>
                </ComboBox>

                <Button x:Name="ClearFilterButton" Grid.Column="2" Content="❌ Clear" Width="100" Height="30" Margin="10,0,0,0" Click="ClearFilterButton_Click" Background="#95A5A6" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="3" x:Name="TransactionsGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  FontSize="14">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding AmountFormatted}" Width="120"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="120"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>